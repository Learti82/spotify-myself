# Copy to .env.local (never commit real values).

# Required in production: the passcode that unlocks the app.
APP_PASSCODE=
# Recommended: random string used to sign the session cookie (e.g. `openssl rand -hex 32`).
AUTH_SECRET=

# Optional: YouTube Data API key, only used to show video durations when importing.
YOUTUBE_API_KEY=

# Optional private cloud backup (server-side only; never exposed to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=music
